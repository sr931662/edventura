<UserControl x:Class="edventura_desktop.Views.RolesPage" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" ... (same card)>
            <StackPanel>
                <TextBlock Text="Create New Role" .../>
                <WrapPanel>
                    <TextBox Text="{Binding NewRoleName}" Width="200" Margin="5" Tag="Role Name"/>
                    <TextBox Text="{Binding NewRoleDescription}" Width="250" Margin="5" Tag="Description"/>
                    <Button Content="Create" Command="{Binding CreateRoleCommand}" .../>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" ... (same card)>
            <DataGrid ItemsSource="{Binding Roles}" (...)>
                <DataGridTextColumn Header="Name" Binding="{Binding name}" .../>
                <DataGridTextColumn Header="Description" Binding="{Binding description}" .../>
                <!-- Delete button column -->
            </DataGrid>
        </Border>
    </Grid>
</UserControl>