<Window x:Class="edventura_desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:edventura_desktop.ViewModels"
        xmlns:helpers="clr-namespace:edventura_desktop.Helpers"
        Title="EdVentura - Login" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Opacity="1"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Color x:Key="PrimaryColor">#3B82F6</Color>
        <Color x:Key="SecondaryColor">#06B6D4</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D4FCFF" Offset="0"/>
            <GradientStop Color="#F3E5F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource SecondaryColor}" Offset="0"/>
            <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Border" x:Key="InputContainer">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Converter for Login button text during loading -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:StringToLoginTextConverter x:Key="StringToLoginTextConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <!-- Decorative ellipses -->
        <Ellipse Width="800" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#333B82F6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-300" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3306B6D4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">

                <!-- EdVentura logo / emblem -->
                <Image Source="pack://application:,,,/Assets/Logo/ic_launcher.png" Height="64" Margin="0,20"/>

                <!-- Login card -->
                <Border Background="White" CornerRadius="24" Padding="40,35">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource PrimaryColor}" BlurRadius="50" ShadowDepth="10" Direction="270" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Welcome Back" FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <!-- Email input -->
                        <Border Style="{StaticResource InputContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="15" Height="25"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <!-- Password input -->
                        <Border Style="{StaticResource InputContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                <PasswordBox x:Name="PasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="15" Height="25"/>
                                <Button Grid.Column="2" Content="👁" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Click="TogglePasswordVisibility" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Keep logged in (optional, can be removed) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <CheckBox Content="Keep me logged in" Foreground="#475569" FontSize="14"/>
                        </StackPanel>

                        <!-- Login button with gradient and loading state -->
                        <Button Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=false}" Height="55" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource ButtonGradient}" CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{StaticResource PrimaryColor}" BlurRadius="20" ShadowDepth="8" Direction="270" Opacity="0.3"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding IsBusy, Converter={StaticResource StringToLoginTextConverter}}" 
                                                   Foreground="White" FontWeight="Bold" FontSize="16" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="Forgot Password?" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center" Margin="0,20,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Biometric / Face ID buttons (non-functional placeholders) -->
                <TextBlock Text="Higher Security" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,35,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#333B82F6" BorderThickness="1" Padding="0,14" Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="3" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="😊" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" FontSize="16"/>
                            <TextBlock Text="Face ID" FontWeight="SemiBold" FontSize="14" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#333B82F6" BorderThickness="1" Padding="0,14" Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="3" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="👆" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" FontSize="16"/>
                            <TextBlock Text="Biometric" FontWeight="SemiBold" FontSize="14" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>