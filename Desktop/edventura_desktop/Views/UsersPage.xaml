<UserControl x:Class="edventura_desktop.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Create User Card -->
        <Border Grid.Row="0" Margin="20,20,20,10" Padding="20" CornerRadius="16" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#3B82F6" BlurRadius="30" ShadowDepth="5" Direction="270" Opacity="0.06"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Create New User" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <WrapPanel Margin="0,10,0,0">
                    <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="5" Tag="Email" Padding="8" BorderBrush="#E2E8F0"/>
                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5" Tag="Full Name" Padding="8" BorderBrush="#E2E8F0"/>
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRoleName}" DisplayMemberPath="name" Width="150" Margin="5" Padding="8"/>
                    <Button Content="Create" Command="{Binding CreateUserCommand}" Margin="5" 
                            Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="12,6" Cursor="Hand"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Users List Card -->
        <Border Grid.Row="1" Margin="20,0,20,20" CornerRadius="16" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#3B82F6" BlurRadius="30" ShadowDepth="5" Direction="270" Opacity="0.06"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding full_name}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
                    <DataGridTextColumn Header="Roles" Binding="{Binding roles[0]}" Width="*"/>
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" Background="Transparent" Cursor="Hand"
                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>