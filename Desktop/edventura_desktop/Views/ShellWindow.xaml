<Window x:Class="edventura_desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:edventura_desktop.ViewModels"
        xmlns:helpers="clr-namespace:edventura_desktop.Helpers"
        Title="EdVentura" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <helpers:OfflineColorConverter x:Key="OfflineColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" CornerRadius="0,20,20,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <!-- Brand area -->
                <StackPanel Margin="20,30">
                    <TextBlock Text="📚" FontSize="30" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="EdVentura OS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRole}" Foreground="#DDD" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation items -->
                <ListBox ItemsSource="{Binding NavigationItems}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="20,10">
                                <TextBlock Text="{Binding Icon}" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Logout" Background="Transparent" Foreground="White" Margin="20,10"
                        Command="{Binding LogoutCommand}" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="0">
            <ContentControl x:Name="MainContent" Content="Welcome to EdVentura" FontSize="28"
                            Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Offline indicator -->
        <Border Background="{Binding StatusText, Converter={StaticResource OfflineColorConverter}}" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4" CornerRadius="4" Margin="10">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="12"/>
        </Border>
    </Grid>
</Window>