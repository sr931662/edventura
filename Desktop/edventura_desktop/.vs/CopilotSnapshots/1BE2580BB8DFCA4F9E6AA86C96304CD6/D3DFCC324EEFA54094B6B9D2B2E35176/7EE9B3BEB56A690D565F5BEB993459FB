<Window x:Class="edventura_desktop.EdVentura"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdVentura" Height="850" Width="1440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Color x:Key="RoyalBlue">#1E3A8A</Color>
        <Color x:Key="RoyalGold">#D97706</Color>
        <Color x:Key="AccentBlue">#3B82F6</Color>

        <SolidColorBrush x:Key="RoyalBlueBrush" Color="{StaticResource RoyalBlue}"/>
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource RoyalGold}"/>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFC" Offset="0"/>
            <GradientStop Color="#F1F5F9" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Border" x:Key="PremiumCard">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1E3A8A" BlurRadius="45" ShadowDepth="10" Direction="270" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SidebarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource RoyalBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2">
            <Ellipse Width="1200" Height="1200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-400,-400,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0F1E3A8A" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="800" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0FD97706" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="🏢" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="EdVentura OS | Owner Portal" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="—" Width="45" Height="35" Background="Transparent" BorderThickness="0" Foreground="#64748B" Click="Minimize_Click"/>
                <Button Content="☐" Width="45" Height="35" Background="Transparent" BorderThickness="0" Foreground="#64748B" Click="Maximize_Click"/>
                <Button Content="✕" Width="45" Height="35" Background="Transparent" BorderThickness="0" Foreground="#64748B" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="0,30,30,0" Padding="20,30">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="2" Opacity="0.05" Direction="0"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,40">
                        <Border Width="50" Height="50" CornerRadius="25" Background="#EFF6FF" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5">
                            <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Vidya Mandir" FontWeight="Bold" FontSize="18" Foreground="{StaticResource RoyalBlueBrush}"/>
                            <TextBlock Text="Director &amp; Owner" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="E X E C U T I V E  V I E W" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="10,0,0,15"/>
                    <Button Style="{StaticResource SidebarBtn}" Background="#F8FAFC" Foreground="{StaticResource RoyalBlueBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,15,0"/>
                            <TextBlock Text="Command Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="₹" FontSize="16" Margin="4,0,17,0"/>
                            <TextBlock Text="Financials &amp; ROI"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" Margin="0,0,15,0"/>
                            <TextBlock Text="AI Ecosystem Metrics"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" Margin="0,0,15,0"/>
                            <TextBlock Text="Staff &amp; Payroll"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarBtn}" Click="StudentManagement_Click" x:Name="StudentMgmtBtn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" Margin="0,0,15,0"/>
                            <TextBlock Text="Student Management"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" Margin="0,0,15,0"/>
                            <TextBlock Text="Batch Performance"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="40,20,40,40">
                <StackPanel>
                    <ContentControl x:Name="ContentArea" />

                    <!-- Dashboard Content -->
                    <StackPanel x:Name="DashboardContent" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Executive Command Center" FontSize="32" FontWeight="Bold" Foreground="{StaticResource RoyalBlueBrush}"/>
                            <TextBlock Text="Real-time insights across 4 branches and 12,000+ students." FontSize="15" Foreground="#64748B" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="{StaticResource RoyalBlueBrush}" Foreground="White" BorderThickness="0" Padding="20,10" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" Margin="0,0,8,0"/>
                                <TextBlock Text="Download OS Report"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,30">
                        <Border Style="{StaticResource PremiumCard}" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Total Revenue (MTD)" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="₹ 2.4 Cr" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,5"/>
                                <TextBlock Text="↑ 12% vs Last Month" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PremiumCard}" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Active Enrollments" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="12,450" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,5"/>
                                <TextBlock Text="840 New Admissions" FontSize="12" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PremiumCard}" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="AI Teacher ROI (Hours Saved)" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="4,250 hrs" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,5"/>
                                <TextBlock Text="Cost saved: ₹ 8.5 L" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PremiumCard}">
                            <StackPanel>
                                <TextBlock Text="Avg. System Latency" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="110 ms" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,5"/>
                                <TextBlock Text="All 4 branches optimal" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Flagship Batches Overview" FontSize="18" FontWeight="Bold" Foreground="{StaticResource RoyalBlueBrush}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="JEE Advanced '26 (Alpha)" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="120 Students | Mentor: SK Singh" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Avg. Test Score: 78%" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10B981"/>
                                    <TextBlock Grid.Column="2" Text="AI Usage: High" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource RoyalBlueBrush}" FontWeight="SemiBold"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,10"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NEET Target '25 (Beta)" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="240 Students | Mentor: Dr. Verma" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Avg. Test Score: 82%" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#10B981"/>
                                    <TextBlock Grid.Column="2" Text="AI Usage: Medium" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PremiumCard}">
                            <StackPanel>
                                <TextBlock Text="AI Engine Status" FontSize="18" FontWeight="Bold" Foreground="{StaticResource RoyalBlueBrush}" Margin="0,0,0,20"/>
                                <TextBlock Text="Automated Subjective Checking" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="14,200 Copies Evaluated" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Accuracy Level" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Text="98.2%" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Manual Reviews" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Text="42 Pending" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

                <!-- Student Management Content -->
                <StackPanel x:Name="StudentManagementContent" Visibility="Collapsed">
                    <TextBlock Text="Student Management" FontSize="32" FontWeight="Bold" Foreground="{StaticResource RoyalBlueBrush}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Padding="10,5" Background="{StaticResource RoyalBlueBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="AddBtn" Content="Add Student" Margin="10,0,0,0" Click="AddBtn_Click" Padding="10,5" Background="{StaticResource GoldBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" Height="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding full_name}" Width="*"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding class_id}" Width="80"/>
                            <DataGridTextColumn Header="Roll No" Binding="{Binding roll_number}" Width="80"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="150"/>
                            <DataGridTextColumn Header="Active" Binding="{Binding is_active}" Width="60"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="View Details" Click="ViewDetails_Click"/>
                                <MenuItem Header="Edit" Click="EditStudent_Click"/>
                                <MenuItem Header="Delete" Click="DeleteStudent_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>