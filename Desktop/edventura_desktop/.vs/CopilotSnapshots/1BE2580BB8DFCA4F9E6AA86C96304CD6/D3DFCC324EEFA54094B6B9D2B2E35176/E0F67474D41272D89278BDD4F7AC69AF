using System;
using System.Net.Http;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Media.Animation;
using edventura_desktop.Models;
using edventura_desktop.Services;

namespace edventura_desktop
{
    public partial class MainWindow : Window
    {
        private bool _isPasswordVisible = false;

        public MainWindow()
        {
            InitializeComponent();
        }

        private async void HandleLogin_Click(object sender, RoutedEventArgs e)
        {
            TextBlock? btnText = LoginButton.Template.FindName("LoginButtonText", LoginButton) as TextBlock;
            if (btnText != null) btnText.Text = "A U T H E N T I C A T I N G . . .";
            LoginButton.IsEnabled = false;
            EmailController.IsEnabled = false;
            PasswordController.IsEnabled = false;

            string email = EmailController.Text.Trim();
            string password = PasswordController.Password; // PasswordBox

            try
            {
                // 1. Login (JSON)
                var loginRequest = new LoginRequest
                {
                    email = email,
                    password = password,
                    tenant_domain = null  // optional, could be set from UI later
                };
                var tokenResponse = await ApiClient.PostAsJsonAsync<LoginRequest, TokenResponse>(
                    "/api/v1/auth/login", loginRequest);

                if (tokenResponse == null)
                    throw new Exception("No token returned");

                // 2. Set tokens in ApiClient and session
                ApiClient.SetTokens(tokenResponse.access_token, tokenResponse.refresh_token);

                // 3. Fetch user profile (requires /auth/me endpoint – see note below)
                Models.UserProfile? user = await ApiClient.GetAsync<Models.UserProfile>("/api/v1/auth/me");
                if (user == null)
                    throw new Exception("Failed to load user profile");

                // 4. Store in session
                UserSession.Instance.Login(tokenResponse.access_token, tokenResponse.refresh_token, user);

                // 5. Navigate to main dashboard
                DoubleAnimation fadeOut = new DoubleAnimation(1, 0, TimeSpan.FromSeconds(0.4));
                fadeOut.Completed += (s, ev) =>
                {
                    // Choose window based on role (simplified: show Dashboard)
                    Window nextWindow = user.is_super_admin
                        ? new DashboardWindow()   // you can replace with an admin-specific window
                        : new DashboardWindow();
                    nextWindow.Show();
                    this.Close();
                };
                this.BeginAnimation(Window.OpacityProperty, fadeOut);
            }
            catch (HttpRequestException httpEx)
            {
                MessageBox.Show($"Login failed: {httpEx.Message}\nCheck your credentials or server connection.",
                    "Authentication Error", MessageBoxButton.OK, MessageBoxImage.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error: {ex.Message}", "Error", MessageBoxButton.OK, MessageBoxImage.Error);
            }
            finally
            {
                if (btnText != null) btnText.Text = "L O G I N";
                LoginButton.IsEnabled = true;
                EmailController.IsEnabled = true;
                PasswordController.IsEnabled = true;
            }
        }

        private void TogglePassword_Click(object sender, RoutedEventArgs e)
        {
            _isPasswordVisible = !_isPasswordVisible;
            Button toggleBtn = (Button)sender;
            toggleBtn.Content = _isPasswordVisible ? "🙈" : "👁";
        }
    }
}