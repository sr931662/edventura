<Window x:Class="edventura_desktop.Views.StudentListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        FontFamily="Segoe UI" Opacity="1"

        >

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Color x:Key="PrimaryColor">#3B82F6</Color>
        <Color x:Key="SecondaryColor">#06B6D4</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D4FCFF" Offset="0"/>
            <GradientStop Color="#F3E5F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource SecondaryColor}" Offset="0"/>
            <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Border" x:Key="InputContainer">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource ButtonGradient}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource PrimaryColor}" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">

        <Ellipse Width="700" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-180,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#333B82F6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="800" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-220" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3306B6D4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" Margin="0,30">

                <TextBlock Text="🎓" FontSize="48" Margin="0,0,0,18" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>

                <Border Background="White" CornerRadius="18" Padding="20" Width="100%">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource PrimaryColor}" BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.08"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Student Management" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <Button x:Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="AddBtn" Content="+ Add Student" Margin="10,0,0,0" Click="AddBtn_Click" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                            <DataGrid x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" RowBackground="White" AlternatingRowBackground="#FBFDFF" GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Full Name" Binding="{Binding full_name}" Width="*"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding class_id}" Width="80"/>
                                    <DataGridTextColumn Header="Roll No" Binding="{Binding roll_number}" Width="80"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="200"/>
                                    <DataGridTextColumn Header="Active" Binding="{Binding is_active}" Width="80"/>
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="View Details" Click="ViewDetails_Click"/>
                                        <MenuItem Header="Edit" Click="EditStudent_Click"/>
                                        <MenuItem Header="Delete" Click="DeleteStudent_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Border>

                    </StackPanel>
                </Border>

                <TextBlock Text="Higher Security" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>