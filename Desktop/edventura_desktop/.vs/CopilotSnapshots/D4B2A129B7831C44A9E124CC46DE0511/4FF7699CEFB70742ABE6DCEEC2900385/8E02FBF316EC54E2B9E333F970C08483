<Window x:Class="edventura_desktop.Views.StudentListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Padding="10,5"/>
            <Button x:Name="AddBtn" Content="Add Student" Margin="10,0,0,0" Click="AddBtn_Click" Padding="10,5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Full Name" Binding="{Binding full_name}" Width="*"/>
                <DataGridTextColumn Header="Class" Binding="{Binding class_id}" Width="80"/>
                <DataGridTextColumn Header="Roll No" Binding="{Binding roll_number}" Width="80"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="150"/>
                <DataGridTextColumn Header="Active" Binding="{Binding is_active}" Width="60"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View Details" Click="ViewDetails_Click"/>
                    <MenuItem Header="Edit" Click="EditStudent_Click"/>
                    <MenuItem Header="Delete" Click="DeleteStudent_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Window>