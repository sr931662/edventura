<Application x:Class="edventura_desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:edventura_desktop"
             xmlns:converters="clr-namespace:edventura_desktop.Converters"
             xmlns:helpers="clr-namespace:edventura_desktop.Helpers">
    <Application.Resources>
        <!-- Existing converters -->
        <converters:BoolToVisibilityConverter     x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter          x:Key="InverseBool"/>
        <converters:InverseBoolConverter          x:Key="InvertBool"/>
        <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility"/>
        <converters:StringToVisibilityConverter   x:Key="StringToVisibility"/>

        <!-- New converters for theming & dashboard -->
        <converters:HexToBrushConverter           x:Key="HexToBrush"/>
        <converters:HexToColorConverter           x:Key="HexToColor"/>
        <converters:TrendColorConverter           x:Key="TrendColor"/>

        <helpers:StringToLoginTextConverter       x:Key="StringToLoginTextConverter"/>

        <!-- Default theme resources — overwritten at runtime by ThemeService -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0A1628" Offset="0"/>
            <GradientStop Color="#0F2040" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentPrimary"   Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentSecondary" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentLight"     Color="#EFF6FF"/>
        <Color           x:Key="AccentPrimaryColor"   >#3B82F6</Color>
        <Color           x:Key="AccentSecondaryColor" >#06B6D4</Color>
    </Application.Resources>
</Application>
