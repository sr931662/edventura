<UserControl x:Class="edventura_desktop.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:edventura_desktop.Converters"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Info row style -->
        <Style TargetType="Border" x:Key="InfoRow">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <!-- Page load animation -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="RootGrid" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Hero card       -->
                <RowDefinition Height="16"/>
                <!-- gap             -->
                <RowDefinition Height="Auto"/>
                <!-- Details panels  -->
            </Grid.RowDefinitions>

            <!-- ── Loading overlay ──────────────────────────────────────── -->
            <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Background="#80FFFFFF" CornerRadius="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Loading profile…" FontSize="15" Foreground="#64748B"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Row 0: Hero card ──────────────────────────────────────── -->
            <Border Grid.Row="0" Background="White" CornerRadius="20" Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="4" Opacity="0.07"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar circle with initials -->
                    <Grid Grid.Column="0" Width="90" Height="90">
                        <!-- Gradient ring -->
                        <Ellipse Width="90" Height="90">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentSecondaryColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentPrimaryColor}"  Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Inner white circle -->
                        <Ellipse Width="82" Height="82" Fill="White"/>
                        <!-- Initials -->
                        <TextBlock Text="{Binding Initials}" FontSize="28"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentPrimary}"/>
                    </Grid>

                    <!-- Name / role / email -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding FullName}" FontSize="22"
                                       FontWeight="Bold" Foreground="#0F172A"/>

                            <!-- Super admin star -->
                            <TextBlock Text=" ⭐" FontSize="18" VerticalAlignment="Center"
                                       Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- Role badge -->
                        <Border CornerRadius="20" Padding="12,4" HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Background="{DynamicResource AccentPrimary}">
                            <TextBlock Text="{Binding BadgeLabel}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✉  " Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock Text="{Binding Email}" FontSize="13" Foreground="#475569"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="📱 " Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="#475569"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Refresh button top-right -->
                    <Button Grid.Column="3" Command="{Binding LoadProfileCommand}"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Cursor="Hand" Height="36" Padding="14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10"
                                        Background="{DynamicResource AccentLight}"
                                        BorderBrush="{DynamicResource AccentPrimary}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="↻ " Foreground="{DynamicResource AccentPrimary}"
                                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" Foreground="{DynamicResource AccentPrimary}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Row 2: Detail panels side-by-side ─────────────────────── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Account Details -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#94A3B8" BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="4" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{DynamicResource AccentPrimary}"/>
                            <TextBlock Text="Account Details" FontSize="15"
                                       FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Roles -->
                        <Border Style="{StaticResource InfoRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Role(s)" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Roles}"
                                           FontSize="13" Foreground="#1E293B"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Super Admin -->
                        <Border Style="{StaticResource InfoRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="System Admin" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="No"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                                        <Setter Property="Text" Value="Yes  ✓"/>
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Tenant -->
                        <Border Style="{StaticResource InfoRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tenant" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TenantInfo}"
                                           FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Permission summary -->
                        <Border Padding="0,12" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Permissions" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PermissionSummary}"
                                           FontSize="13" Foreground="#1E293B"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Security & Contact -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#94A3B8" BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="4" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{DynamicResource AccentSecondary}"/>
                            <TextBlock Text="Security &amp; Settings" FontSize="15"
                                       FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- MFA -->
                        <Border Style="{StaticResource InfoRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2-FA Status" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3"
                                        Background="#FEF2F2" HorizontalAlignment="Left">
                                    <TextBlock Text="Not configured" FontSize="12"
                                               Foreground="#EF4444" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Last login -->
                        <Border Style="{StaticResource InfoRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last Login" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Just now" FontSize="13"
                                           Foreground="#1E293B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Session -->
                        <Border Style="{StaticResource InfoRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Session" FontSize="13"
                                           Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3"
                                        Background="#ECFDF5" HorizontalAlignment="Left">
                                    <TextBlock Text="Active  🟢" FontSize="12"
                                               Foreground="#059669" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Change password placeholder -->
                        <Border Padding="0,14" BorderThickness="0">
                            <Button Cursor="Hand" HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="10"
                                                Background="{DynamicResource AccentLight}"
                                                BorderBrush="{DynamicResource AccentPrimary}"
                                                BorderThickness="1" Padding="16,9">
                                            <TextBlock Text="🔐  Change Password"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentPrimary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
