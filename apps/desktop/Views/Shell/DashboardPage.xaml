<Page x:Class="edventura_desktop.Views.Shell.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" FontFamily="Segoe UI">

    <Page.Resources>
        <!-- ── Stat card hover style ────────────────────────────────────── -->
        <Style TargetType="Border" x:Key="StatCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="18" ShadowDepth="4" Opacity="0.07"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.025" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.025" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Effect).Opacity"
                                                 To="0.15" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Effect).Opacity"
                                                 To="0.07" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Panel card (white container) ─────────────────────────────── -->
        <Style TargetType="Border" x:Key="PanelCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Quick-action card hover ─────────────────────────────────── -->
        <Style TargetType="Border" x:Key="ActionCard">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.06" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.06" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- Page load animation -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45"/>
                    <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="20" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ContentGrid" Margin="28,24,28,28" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header              -->
                <RowDefinition Height="16"/>
                <!-- gap                 -->
                <RowDefinition Height="Auto"/>
                <!-- Stat cards          -->
                <RowDefinition Height="16"/>
                <!-- gap                 -->
                <RowDefinition Height="Auto"/>
                <!-- Main 2-col content  -->
                <RowDefinition Height="16"/>
                <!-- gap                 -->
                <RowDefinition Height="Auto"/>
                <!-- Student schedule     -->
            </Grid.RowDefinitions>

            <!-- ── Row 0: Header ──────────────────────────────────────────── -->
            <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="24,18">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: greeting -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#0F172A">
                                <Run Text="{Binding GreetingPrefix}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding GreetingName}"/>
                                <Run Text=" 👋"/>
                            </TextBlock>

                            <!-- Role badge -->
                            <Border CornerRadius="20" Margin="12,0,0,0" Padding="12,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentPrimary}">
                                <TextBlock Text="{Binding RoleBadge}"
                                           Foreground="White" FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding WelcomeSubtext}"
                                   FontSize="14" Foreground="#64748B" Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Right: date + refresh -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TodayDate}"
                                   FontSize="13" Foreground="#94A3B8"
                                   HorizontalAlignment="Right" Margin="0,0,0,8"/>

                        <Button Command="{Binding LoadDataCommand}" Cursor="Hand"
                                Height="38" Padding="16,0" HorizontalAlignment="Right">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            Background="{DynamicResource ButtonGradient}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="↻" Foreground="White" FontSize="16"
                                                       FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Row 2: Stat cards ──────────────────────────────────────── -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding StatCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label + value + trend -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Trend}" FontSize="11"
                                               Foreground="{Binding IsUp, Converter={StaticResource TrendColor}}"/>
                                </StackPanel>

                                <!-- Icon circle -->
                                <Border Grid.Column="1" Width="48" Height="48"
                                        CornerRadius="14" VerticalAlignment="Center"
                                        Background="{Binding IconBg, Converter={StaticResource HexToBrush}}">
                                    <TextBlock Text="{Binding Icon}" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Row 4: Two-column content ─────────────────────────────── -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Recent Activity  -->
                    <ColumnDefinition Width="10"/>
                    <!-- gutter           -->
                    <ColumnDefinition Width="280"/>
                    <!-- Quick Actions    -->
                </Grid.ColumnDefinitions>

                <!-- Left: Recent Activity feed -->
                <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <!-- Section header -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="4" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{DynamicResource AccentPrimary}"/>
                                <TextBlock Text="Recent Activity" FontSize="16"
                                           FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="View all →"
                                       FontSize="12" Foreground="{DynamicResource AccentPrimary}"
                                       Cursor="Hand" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Activity items -->
                        <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon bubble -->
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="10" HorizontalAlignment="Center"
                                                Background="{Binding DotColor, Converter={StaticResource HexToBrush}}">
                                            <Border.Opacity>0.15</Border.Opacity>
                                        </Border>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Title + description -->
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Time ago -->
                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}"
                                                   FontSize="11" Foreground="#94A3B8"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Quick Actions -->
                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <!-- Section header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="4" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{DynamicResource AccentSecondary}"/>
                            <TextBlock Text="Quick Actions" FontSize="16"
                                       FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 2-column grid of action cards -->
                        <ItemsControl ItemsSource="{Binding QuickActions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ActionCard}"
                                            Background="{Binding Bg, Converter={StaticResource HexToBrush}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="24"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{Binding Fg, Converter={StaticResource HexToBrush}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mini divider + session info -->
                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,18,0,14"/>

                        <StackPanel>
                            <TextBlock Text="Session Info" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔒" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Secure · HTTPS"
                                           FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🕐" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding TodayDate}"
                                           FontSize="12" Foreground="#94A3B8"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Row 6: Student-only schedule ──────────────────────────── -->
            <Border Grid.Row="6" Style="{StaticResource PanelCard}"
                    Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" CornerRadius="2" Margin="0,0,10,0"
                                Background="{DynamicResource AccentPrimary}"/>
                        <TextBlock Text="Today's Schedule" FontSize="16"
                                   FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Schedule rows -->
                    <ItemsControl ItemsSource="{Binding Schedule}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentLight}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFree}" Value="True">
                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="#64748B" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Subject}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1E293B" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Room}"
                                                   FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- NOW badge -->
                                        <Border Grid.Column="3" CornerRadius="4" Padding="7,2"
                                                Background="{DynamicResource AccentPrimary}"
                                                Visibility="{Binding IsNow, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="NOW" FontSize="10" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
