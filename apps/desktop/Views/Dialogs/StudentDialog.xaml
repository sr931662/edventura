<Window x:Class="edventura_desktop.Views.Dialogs.StudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student" Height="600" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="First Name *" Margin="0,0,0,5"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Last Name *" Margin="0,0,0,5"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Middle Name"/>
                <TextBox Text="{Binding MiddleName}" Margin="0,0,0,10"/>

                <TextBlock Text="Date of Birth *"/>
                <DatePicker SelectedDate="{Binding DateOfBirth}" Margin="0,0,0,10"/>

                <TextBlock Text="Gender *"/>
                <ComboBox SelectedItem="{Binding Gender}" Margin="0,0,0,10">
                    <ComboBoxItem>Male</ComboBoxItem>
                    <ComboBoxItem>Female</ComboBoxItem>
                    <ComboBoxItem>Other</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Admission Date *"/>
                <DatePicker SelectedDate="{Binding AdmissionDate}" Margin="0,0,0,10"/>

                <TextBlock Text="Blood Group"/>
                <TextBox Text="{Binding BloodGroup}" Margin="0,0,0,10"/>

                <TextBlock Text="Medical Notes"/>
                <TextBox Text="{Binding MedicalNotes}" Margin="0,0,0,10" TextWrapping="Wrap" Height="60"/>

                <TextBlock Text="Class"/>
                <TextBox Text="{Binding Section}" Margin="0,0,0,10" ToolTip="Class ID or name"/>

                <TextBlock Text="Roll Number"/>
                <TextBox Text="{Binding RollNumber}" Margin="0,0,0,10"/>

                <TextBlock Text="Email"/>
                <TextBox Text="{Binding Email}" Margin="0,0,0,10"/>

                <TextBlock Text="Phone"/>
                <TextBox Text="{Binding Phone}" Margin="0,0,0,10"/>

                <TextBlock Text="Address"/>
                <TextBox Text="{Binding Address}" Margin="0,0,0,10"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="5" Padding="10,5"/>
                    <Button Grid.Column="2" Content="Save" Click="Save_Click" Margin="5" Padding="10,5"
                            Background="#3B82F6" Foreground="White" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>