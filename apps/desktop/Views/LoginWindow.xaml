<Window x:Class="edventura_desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:edventura_desktop.Helpers"
        Title="EdVentura – Login" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SineEase x:Key="SineEase" EasingMode="EaseInOut"/>
        <Color x:Key="PrimaryColor">#3B82F6</Color>
        <Color x:Key="SecondaryColor">#06B6D4</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D4FCFF" Offset="0"/>
            <GradientStop Color="#F3E5F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource SecondaryColor}" Offset="0"/>
            <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
        </LinearGradientBrush>

        <!-- 3D Pop Style for Security Cards -->
        <Style TargetType="Border" x:Key="SecurityCard">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#3B82F633"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="3" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Effect).ShadowDepth" To="8" Duration="0:0:0.15"/>
                                <ColorAnimation Storyboard.TargetProperty="(Effect).Color" To="#3B82F6" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Effect).ShadowDepth" To="3" Duration="0:0:0.15"/>
                                <ColorAnimation Storyboard.TargetProperty="(Effect).Color" To="Gray" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Entrance and Ambient Animations -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Main Card Smooth Pop-in -->
                    <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>

                    <!-- Ambient Floating Orbs -->
                    <DoubleAnimation Storyboard.TargetName="Orb1Translate" Storyboard.TargetProperty="Y" From="0" To="-25" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineEase}"/>
                    <DoubleAnimation Storyboard.TargetName="Orb1Translate" Storyboard.TargetProperty="X" From="0" To="15" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineEase}"/>

                    <DoubleAnimation Storyboard.TargetName="Orb2Translate" Storyboard.TargetProperty="Y" From="0" To="30" Duration="0:0:6.5" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineEase}"/>
                    <DoubleAnimation Storyboard.TargetName="Orb2Translate" Storyboard.TargetProperty="X" From="0" To="-20" Duration="0:0:5.5" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Main Border to provide rounded corners for the entire window -->
    <Border CornerRadius="12" Background="{StaticResource BackgroundGradient}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <!-- Title Bar Row -->
                <RowDefinition Height="*"/>
                <!-- Content Row -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="10">
                <TextBlock Text="EdVentura" Foreground="#64748B" FontWeight="SemiBold" FontSize="13" 
                           VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="45" Height="35" Background="Transparent" BorderThickness="0" 
                            Foreground="#64748B" FontSize="12" Cursor="Hand" Click="Minimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A000000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="45" Height="35" Background="Transparent" BorderThickness="0" 
                            Foreground="#64748B" FontSize="14" Cursor="Hand" Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Orbs -->
            <Ellipse Grid.RowSpan="2" Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-100,-100,0,0" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb1Translate" X="0" Y="0"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4D3B82F6" Offset="0"/>
                        <GradientStop Color="#003B82F6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Grid.RowSpan="2" Width="350" Height="350" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-120,-120" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb2Translate" X="0" Y="0"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4D06B6D4" Offset="0"/>
                        <GradientStop Color="#0006B6D4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Margin="0,10,0,40">
                    <Image Source="pack://application:,,,/Assets/Logo/ic_launcher.png" Height="96" Margin="0,20,0,30"/>

                    <Border x:Name="MainCard" Background="White" CornerRadius="24" Padding="30" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.12"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold"
                                       Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                            <!-- Email -->
                            <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👤" Grid.Column="0" VerticalAlignment="Center"
                                               Foreground="#94A3B8" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             VerticalAlignment="Center" FontSize="15" Height="28"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Border>

                            <!-- Password -->
                            <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔒" Grid.Column="0" VerticalAlignment="Center"
                                               Foreground="#94A3B8" FontSize="18" Margin="0,0,10,0"/>
                                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" Background="Transparent"
                                                 BorderThickness="0" VerticalAlignment="Center" FontSize="15" Height="28"/>
                                    <Button Grid.Column="2" Content="👁" Background="Transparent"
                                            BorderThickness="0" Foreground="#94A3B8" FontSize="18"
                                            Click="TogglePasswordVisibility" Cursor="Hand" Padding="4"/>
                                </Grid>
                            </Border>

                            <CheckBox Content="Keep me logged in" Foreground="#475569" FontSize="14" Margin="0,0,0,20"/>

                            <Button Command="{Binding LoginCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                    Height="55" Cursor="Hand" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{StaticResource ButtonGradient}" CornerRadius="14">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="20" ShadowDepth="8" Direction="270" Opacity="0.3"/>
                                            </Border.Effect>
                                            <TextBlock Text="{Binding IsBusy, Converter={StaticResource StringToLoginTextConverter}}"
                                                       Foreground="White" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#06B6D4" BlurRadius="25" ShadowDepth="12" Direction="270" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Text="Forgot Password?" Foreground="#64748B" FontSize="13"
                                       HorizontalAlignment="Center" Cursor="Hand" TextDecorations="Underline"
                                       MouseLeftButtonDown="ForgotPassword_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Higher Security" Foreground="#64748B" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,30,0,12"/>

                    <UniformGrid Columns="2" Rows="1" Margin="0">
                        <Border Style="{StaticResource SecurityCard}" Margin="0,0,10,0"
                                MouseLeftButtonDown="FaceId_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="😊" Foreground="{StaticResource PrimaryBrush}" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Face ID" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SecurityCard}" MouseLeftButtonDown="Biometric_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="👆" Foreground="{StaticResource PrimaryBrush}" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Biometric" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>