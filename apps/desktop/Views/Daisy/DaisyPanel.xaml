<UserControl x:Class="edventura_desktop.Views.Daisy.DaisyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" FontFamily="Segoe UI"
             ClipToBounds="False">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PanelSlide" X="400"/>
    </UserControl.RenderTransform>

    <!-- Outer shadow (left edge glow when open) -->
    <Border CornerRadius="16,0,0,16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Direction="180" BlurRadius="28"
                              ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header         -->
                <RowDefinition Height="*"/>
                <!-- Messages       -->
                <RowDefinition Height="Auto"/>
                <!-- Thinking dots  -->
                <RowDefinition Height="Auto"/>
                <!-- Quick prompts  -->
                <RowDefinition Height="Auto"/>
                <!-- Input bar      -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 0 — Gradient header (role-colored via DynamicResource) -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Padding="16,14,12,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource AccentSecondaryColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AccentPrimaryColor}"   Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Daisy avatar -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                            Background="#33FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="🌼" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name + status -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Daisy" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#4ADE80"
                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="EdVentura Assistant" FontSize="11"
                                       Foreground="#CCffffff" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="2" x:Name="BtnClose"
                            Width="34" Height="34" Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBd" CornerRadius="17"
                                        Background="Transparent">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                               Foreground="#CCffffff"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBd" Property="Background" Value="#22000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 1 — Messages scroll area                               -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#F0F4F8" Padding="12,10">

                <StackPanel>
                    <ItemsControl x:Name="MessagesControl" ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <!-- Alignment switches based on IsUser -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">

                                        <!-- Daisy mini-avatar (assistant only, left side) -->
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Margin="0,0,7,0" VerticalAlignment="Bottom">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentLight}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="🌼" FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Message bubble -->
                                        <Border MaxWidth="262" CornerRadius="14,14,14,4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- User: accent-colored bubble, right tail -->
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentPrimary}"/>
                                                    <Setter Property="CornerRadius" Value="14,14,4,14"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="10"
                                                                              ShadowDepth="2"
                                                                              Opacity="0.15"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Daisy: white bubble, left tail -->
                                                        <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="CornerRadius" Value="14,14,14,4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <!-- Message text -->
                                                <TextBlock Text="{Binding Content}"
                                                           TextWrapping="Wrap" FontSize="13"
                                                           LineHeight="20">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Timestamp -->
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           FontSize="10" Margin="0,5,0,0"
                                                           Opacity="0.55">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom spacer so last message isn't right against the scroll edge -->
                    <Border Height="6"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 2 — Animated thinking dots                             -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#F0F4F8" Padding="16,6"
                    Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <!-- Mini avatar -->
                    <Border Width="26" Height="26" CornerRadius="13"
                            Background="{DynamicResource AccentLight}" Margin="0,0,8,0">
                        <TextBlock Text="🌼" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Dots bubble -->
                    <Border Background="White" CornerRadius="12" Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot1" Width="7" Height="7"
                                     Fill="{DynamicResource AccentPrimary}" Margin="2,0" Opacity="1"/>
                            <Ellipse x:Name="Dot2" Width="7" Height="7"
                                     Fill="{DynamicResource AccentPrimary}" Margin="2,0" Opacity="0.4"/>
                            <Ellipse x:Name="Dot3" Width="7" Height="7"
                                     Fill="{DynamicResource AccentPrimary}" Margin="2,0" Opacity="0.4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 3 — Quick-prompt chips (shown when no messages yet)    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#F0F4F8" Padding="10,6,10,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <WrapPanel>
                    <Button x:Name="ChipStudent"  Content="🎓 Add student?"  Click="Chip_Click"
                            Tag="How do I add a new student?"/>
                    <Button x:Name="ChipAttend"   Content="📅 Attendance?"   Click="Chip_Click"
                            Tag="Where can I view attendance reports?"/>
                    <Button x:Name="ChipFees"     Content="💰 Fee status?"   Click="Chip_Click"
                            Tag="How do I check fee collection status?"/>
                    <Button x:Name="ChipPerms"    Content="🔑 My permissions?" Click="Chip_Click"
                            Tag="What permissions do I have?"/>
                </WrapPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 4 — Input bar                                          -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4" Background="White" Padding="10,10,10,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                      Opacity="0.07" Direction="90"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Text input with placeholder -->
                    <Border Grid.Column="0" CornerRadius="22"
                            Background="#F1F5F9" BorderThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=InputBox, Path=IsFocused}"
                                                 Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource AccentPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="14,0">
                            <!-- Placeholder text -->
                            <TextBlock Text="Ask Daisy anything…" FontSize="13"
                                       Foreground="#94A3B8" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="InputBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="13" Foreground="#1E293B"
                                     VerticalAlignment="Center" Padding="0,8"
                                     MaxLines="4" TextWrapping="Wrap"
                                     KeyDown="InputBox_KeyDown"
                                     AcceptsReturn="False"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>

                    <!-- Send button -->
                    <Button Grid.Column="1" Width="44" Height="44"
                            Margin="8,0,0,0" Cursor="Hand"
                            Command="{Binding SendCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SendBd" CornerRadius="22"
                                        Background="{DynamicResource ButtonGradient}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                          Opacity="0.25"/>
                                    </Border.Effect>
                                    <TextBlock Text="▶" FontSize="14" FontWeight="Bold"
                                               Foreground="White" Margin="2,0,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SendBd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="SendBd" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
